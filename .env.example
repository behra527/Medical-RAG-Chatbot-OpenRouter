# API key from https://openrouter.ai/settings/keys. NEVER put keys in frontend JS or Git.
OPENROUTER_API_KEY=replace_with_your_key
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local persistent data; source PDF files are retained with SHA-derived names.
RAG_DB_PATH=data/medical_rag.sqlite3
RAG_PDF_DIR=data/guidelines
MIN_SIMILARITY=0.40
CHUNK_WORDS=190
CHUNK_OVERLAP=40
TOP_K=5
MAX_UPLOAD_MB=20

# REQUIRED before any network-facing deployment. Use a long, random key.
ADMIN_API_KEY=replace_with_random_admin_secret
APP_ENV=development

# Legacy optional Streamlit app only (premium UI is on the FastAPI root URL).
API_URL=http://127.0.0.1:8000
